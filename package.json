{
  "name": "osu-replay-editor",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/desktop", "packages/beatmap-viewer"],
  "scripts": {
    "postinstall": "node scripts/ensure-app-config.mjs",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "sidecar:build": "powershell -ExecutionPolicy Bypass -File scripts/prepare-sidecar.ps1",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1",
    "ui:dev": "npm run dev --workspace @ore/desktop",
    "ui:build": "npm run build --workspace @ore/desktop",
    "check": "npm run check --workspace @ore/desktop",
    "format": "prettier --write \"apps/desktop/src/**/*.{ts,tsx}\" \"packages/beatmap-viewer/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"apps/desktop/src/**/*.{ts,tsx}\" \"packages/beatmap-viewer/src/**/*.{ts,tsx}\"",
    "test:viewer": "node --experimental-strip-types --test tests/frontend/beatmap-viewer-parser.test.mts tests/frontend/beatmap-viewer-replay.test.mts tests/frontend/project-file.test.mts",
    "test:replay": "node --experimental-strip-types --test tests/frontend/replay-store.test.mts && dotnet test tests/engine/ReplayEditor.M4Smoke/ReplayEditor.M4Smoke.csproj -m:1 -p:NuGetAudit=false -p:UseSharedCompilation=false",
    "test:simulation": "dotnet test tests/engine/ReplayEditor.SimulationSmoke/ReplayEditor.SimulationSmoke.csproj -m:1 -p:NuGetAudit=false -p:UseSharedCompilation=false",
    "test:auth": "dotnet test tests/engine/ReplayEditor.M2Smoke/ReplayEditor.M2Smoke.csproj -m:1 -p:NuGetAudit=false -p:UseSharedCompilation=false"
  }
}
